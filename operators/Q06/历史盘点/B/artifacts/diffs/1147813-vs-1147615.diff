+    // A conservative product of per-axis inverse-map sizes selects a compact
+    // Gather layout. Saturation preserves the existing >64-contributor fallback.
+    __aicore__ inline int64_t FlatGroupSize() const
+    {
+        if (data_->totalInput == 0) {
+            return 8;
+        }
+        int64_t bound = 1;
+        for (int64_t d = 0; d < rank_; ++d) {
+            const int64_t input = data_->inputShape[d];
+            const int64_t output = data_->outputShape[d];
+            if (input == 0) {
+                return 8;
+            }
+            int64_t axis = 1;
+            if (input != output || front_[d] != 0) {
+                if (data_->mode == PadV3GradIndex::CONSTANT) {
+                    axis = 1;
+                } else if (output == 1) {
+                    axis = input;
+                } else if (data_->mode == PadV3GradIndex::EDGE) {
+                    const int64_t first = MakeContributors(0, input, output, front_[d], data_->mode).Size();
+                    const int64_t last = MakeContributors(output - 1, input, output, front_[d], data_->mode).Size();
+                    axis = first > last ? first : last;
+                    if (axis < 1) { axis = 1; }
+                } else if (data_->mode == PadV3GradIndex::CIRCULAR) {
+                    axis = input / output + (input % output != 0);
+                } else {
+                    const int64_t period = data_->mode == PadV3GradIndex::REFLECT ?
+                        2 * (output - 1) : 2 * output;
+                    const int64_t perResidue = input / period + (input % period != 0);
+                    axis = perResidue > 32 ? 65 : 2 * perResidue;
+                }
+            }
+            axis = Min(axis, 65);
+            bound = bound > 64 / axis ? 65 : bound * axis;
+        }
+        return bound <= 8 ? 8 : (bound <= 16 ? 16 : (bound <= 32 ? 32 : 64));
+    }

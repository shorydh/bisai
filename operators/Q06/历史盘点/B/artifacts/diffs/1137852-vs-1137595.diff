-    // A core with at most 128 outputs can use 64 slots per output in the
-    // existing 8192-element buffers. No buffer allocation changes are needed.
+    __aicore__ inline int64_t FlatGroupSize() const
+    {
+        int64_t bound = 1;
+        for (int64_t d = 0; d < rank_; ++d) {
+            const int64_t input = data_->inputShape[d];
+            const int64_t output = data_->outputShape[d];
+            int64_t axis = 1;
+            if (input == 0) { return 8; }
+            if (input == output && front_[d] == 0) { continue; }
+            if (data_->mode == PadV3GradIndex::CONSTANT) {
+                axis = 1;
+            } else if (output == 1) {
+                axis = input;
+            } else if (data_->mode == PadV3GradIndex::EDGE) {
+                const auto first = MakeContributors(0, input, output, front_[d], data_->mode);
+                const auto last = MakeContributors(output - 1, input, output, front_[d], data_->mode);
+                axis = first.Size() > last.Size() ? first.Size() : last.Size();
+                if (axis < 1) { axis = 1; }
+            } else {
+                const int64_t period = data_->mode == PadV3GradIndex::REFLECT ?
+                    2 * (output - 1) : (data_->mode == PadV3GradIndex::SYMMETRIC ? 2 * output : output);
+                axis = input / period + (input % period != 0);
+                if (data_->mode != PadV3GradIndex::CIRCULAR) { axis *= 2; }
+            }
+            // Saturate before multiplying: >32 needs the original 64-slot plan.
+            if (axis > 32 / bound) { return 64; }
+            bound *= axis;
+        }
+        return bound <= 8 ? 8 : (bound <= 16 ? 16 : 32);
+    }

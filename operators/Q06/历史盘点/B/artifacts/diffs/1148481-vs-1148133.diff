+    // Every output uses at most n input elements. A uniform input bound K/p,
+    // with p the next power of two >= n, implies sum(abs(contributors)) <= K.
+    // K is the original conservative certificate budget, not a new tolerance.
+    __aicore__ inline bool InputRangeCertified(int64_t contributors)
+    {
+        if (contributors == 0) {
+            return true;
+        }
+        const int64_t inputCount = data_->totalInput;
+        if (inputCount > 256) {
+            return false;
+        }
+        float limit = sizeof(T) == sizeof(half) ?
+            (contributors <= 32 ? 256.0f : 128.0f) :
+            (contributors <= 32 ? 26.0f : 13.0f);
+        for (int64_t power = 1; power < contributors; power *= 2) {
+            limit *= 0.5f;
+        }
+        const int64_t compareBlock = 256 / sizeof(T);
+        const uint32_t compareCount = static_cast<uint32_t>(
+            (inputCount + compareBlock - 1) / compareBlock * compareBlock);
+        // Gather has finished with its offsets. Reuse that buffer for the
+        // input range check; zero padding makes every compared tail bit valid.
+        auto absolute = offsetBuffer_.Get<T>();
+        Duplicate(absolute, static_cast<T>(0), compareCount);
+        PipeBarrier<PIPE_V>();
+        Abs(absolute, inputBuffer_.Get<T>(), static_cast<uint32_t>(inputCount));
+        PipeBarrier<PIPE_V>();
+        CompareScalar(maskBuffer_.Get<uint8_t>(), absolute, static_cast<T>(limit), CMPMODE::LE, compareCount);
+        Sync<HardEvent::V_S>();
+        auto words = maskBuffer_.Get<uint32_t>();
+        for (uint32_t word = 0; word < compareCount / 32; ++word) {
+            // Ordered <= rejects NaN and infinity as well as large magnitudes.
+            if (words.GetValue(word) != static_cast<uint32_t>(0xffffffffu)) {
+                Sync<HardEvent::S_V>();
+                return false;
+            }
+        }
+        return true;
+    }
+
+    __aicore__ inline void StoreRangeCertified(const LocalTensor<float> &values,
+                                               int64_t count, int32_t terms)
+    {
+        auto sum = sumBuffer_.Get<float>();
+        ReduceGroups(sum, values, count, terms, 64);
+        PipeBarrier<PIPE_V>();
+        auto out = outputBuffer_.Get<T>();
+        if constexpr (sizeof(T) == sizeof(half)) {
+            Cast(out, sum, RoundMode::CAST_RINT, static_cast<uint32_t>(count));
+        } else {
+            Adds(out, sum, 0.0f, static_cast<uint32_t>(count));
+        }
+        Store(begin_, count, false);
+    }

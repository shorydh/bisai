+    const int64_t t1 = PadCeilDiv(jhi - r, step) - 1;
+    int64_t cnt = t1 - t0 + 1;
+    if (cnt < 0) {
+        cnt = 0;
+    }
+    gr_[slot] = r;
+    gs_[slot] = step;
+    gt0_[slot] = t0;
+    gcnt_[slot] = cnt;
+}
